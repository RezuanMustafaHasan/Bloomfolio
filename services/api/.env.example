PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017/bloomfolio
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:5173
# Optional: required only for the AI advisor
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

MARKET_DATA_URL=http://127.0.0.1:8000
# Local AI (no API key): install Ollama, then ollama pull qwen3:0.6b
# To use Gemini instead, set AI_PROVIDER=gemini and configure a valid key above.
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b
